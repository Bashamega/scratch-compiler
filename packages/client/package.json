{
  "name": "@scratch-compiler/client",
  "version": "0.1.0",
  "description": "Scratch runtime for the browser",
  "dependencies": {
    "@scratch-compiler/types": "workspace:*",
    "konva": "^10.2.3"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --sourcemap --outfile=../cli/static/src/engine.min.js --format=esm --target=es2020",
    "dev": "esbuild src/index.ts --bundle --sourcemap --outfile=../cli/static/src/engine.min.js --format=esm --watch"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "^5.4.0"
  }
}
