{
  "name": "@scratch-compiler/client",
  "version": "1.0.0",
  "description": "Scratch runtime for the browser",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scratch",
    "compiler",
    "runtime",
    "browser",
    "stage",
    "sprite",
    "sb3",
    "blocks",
    "education"
  ],
  "author": "OpenAI & scratch-compiler contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bashamega/scratch-compiler"
  },
  "dependencies": {
    "@scratch-compiler/types": "workspace:*",
    "konva": "^10.2.3"
  },
  "scripts": {
    "build": "pnpm run build:dist && pnpm run build:cli-bundle",
    "build:dist": "esbuild src/index.ts --bundle --minify --sourcemap --outfile=dist/index.js --format=esm --target=es2020",
    "build:cli-bundle": "esbuild src/index.ts --bundle --minify --sourcemap --outfile=../cli/static/src/engine.min.js --format=esm --target=es2020",
    "dev": "esbuild src/index.ts --bundle --sourcemap --outfile=../cli/static/src/engine.min.js --format=esm --watch"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "^5.4.0"
  }
}
