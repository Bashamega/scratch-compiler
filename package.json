{
  "name": "scratch-compiler",
  "version": "0.1.0",
  "description": "Compile Scratch projects into HTML, JavaScript, and CSS",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm run client:build && pnpm run cli:build",
    "cli:build": "pnpm --filter @scratch-compiler/cli run build",
    "cli:start": "pnpm --filter @scratch-compiler/cli run start",
    "client:build": "pnpm --filter @scratch-compiler/client run build",
    "client:bundle": "pnpm --filter @scratch-compiler/client run build",
    "client:dev": "pnpm --filter @scratch-compiler/client run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "scratch",
    "compiler",
    "typescript",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "esbuild": "^0.27.4",
    "typescript": "^5.4.0"
  }
}
