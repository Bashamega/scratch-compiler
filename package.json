{
  "name": "scratch-compiler",
  "version": "0.1.0",
  "description": "Compile Scratch projects into HTML, JavaScript, and CSS",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli:build": "npm run build -w @scratch-compiler/cli",
    "cli:start": "npm run start -w @scratch-compiler/cli",
    "client:build": "npm run build -w @scratch-compiler/client",
    "client:bundle": "npm run bundle -w @scratch-compiler/client",
    "client:dev": "npm run dev -w @scratch-compiler/client"
  },
  "keywords": [
    "scratch",
    "compiler",
    "typescript",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
